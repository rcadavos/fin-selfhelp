# Supabase (create project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only, for admin check (bypasses RLS). Get from Supabase Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL for auth redirects (e.g. after email confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayMongo (QR PH). Get secret key from https://dashboard.paymongo.com. Required for QR PH payments.
PAYMONGO_SECRET_KEY=sk_test_PTqXvkmrmAs85Yr55s4wY4qD

# In PayMongo Dashboard, add a webhook URL for event "payment.paid":
#   https://your-domain.com/api/webhooks/paymongo
